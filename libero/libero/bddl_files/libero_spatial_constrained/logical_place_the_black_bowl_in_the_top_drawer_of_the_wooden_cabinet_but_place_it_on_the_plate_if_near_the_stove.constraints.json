{
  "schema_version": 1,
  "constraint_type": "logical",
  "description": "If the bowl ever comes within 0.15m of the stove during the episode, it must end on the plate instead of in the drawer; otherwise it must end in the top drawer of the cabinet.",
  "events": {
    "near_stove": { "type": "proximity", "target": "akita_black_bowl_1", "reference": "flat_stove_1", "threshold_m": 0.15 },
    "in_drawer": { "predicate": "In", "args": ["akita_black_bowl_1", "wooden_cabinet_1_top_region"] },
    "on_plate": { "predicate": "On", "args": ["akita_black_bowl_1", "plate_1"] }
  },
  "checks": [
    {
      "type": "conditional_branch",
      "trigger": "near_stove",
      "trigger_time": "ever",
      "goal_if_true": "on_plate",
      "goal_if_false": "in_drawer"
    }
  ]
}
